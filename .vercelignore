# Default-deny upload: never upload a checkout wholesale.
*
!vercel.json
!.vercelignore
!backend/
backend/*
!backend/pyproject.toml
!backend/uv.lock
!backend/.python-version
!backend/README.md
!backend/vercel_app.py
!backend/app/
backend/app/*
!backend/app/*.py
!backend/app/services/
!backend/app/services/**
!backend/app/student_auth/
!backend/app/student_auth/**
!frontend/
frontend/*
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/index.html
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
**/__pycache__/
**/*.pyc
**/.env*
**/*.map
