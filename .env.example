# Copy to .env.local; literal values, no shell expressions. Process environment wins.
# Select your EXISTING local database. Startup never creates/migrates/seeds it.
# Passwordless URLs below are only for a loopback-only local trust container.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55433/utscvacant_dev
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55433/postgres
POSTGRES_CONTAINER=utscvacant-pg-local
