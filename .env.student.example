# Runtime-only private configuration. Copy to .env.student and fill every beta value.
# Empty required values deliberately leave timetable access closed.
STUDENT_AUTH_MODE=beta
STUDENT_AUTH_ORIGIN=http://127.0.0.1:5173
STUDENT_AUTH_DATABASE_URL=
STUDENT_AUTH_EPOCH=
STUDENT_BETA_PASSWORD_HASH=
STUDENT_BETA_ENDS_AT=
STUDENT_AUTH_TTL_SECONDS=604800
# University mode also requires these values. Domains and policy must be explicitly approved.
# STUDENT_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# STUDENT_SUPABASE_PUBLISHABLE_KEY=
# STUDENT_AUTH_ENCRYPTION_KEY=
# STUDENT_AUTH_EMAIL_DOMAINS=
# STUDENT_AUTH_ELIGIBILITY=approved_metadata
# STUDENT_SUPABASE_AUDIENCE=authenticated
# Never put migration/admin/operator credentials or VITE_* values in this file.
